{
  "name": "gpm",
  "version": "0.1.0",
  "private": true,
  "description": "Clone Git repositories into predictable host-based paths",
  "bin": {
    "gpm": "dist/gpm"
  },
  "type": "module",
  "scripts": {
    "build": "mkdir -p dist && scriptc build src/main.ts --no-keep-c -o dist/gpm",
    "coverage": "scriptc coverage src/main.ts",
    "format": "vp fmt . --check",
    "lint": "vp lint src test",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "scriptc": "0.0.28",
    "typescript": "5.9.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
