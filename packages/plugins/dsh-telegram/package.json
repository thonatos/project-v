{
  "name": "@implementsio/dsh-telegram",
  "version": "0.3.1",
  "description": "Telegram Bot API plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "telegram"
  ],
  "homepage": "https://github.com/thonatos/project-v/tree/main/packages/plugins/dsh-telegram#readme",
  "bugs": {
    "url": "https://github.com/thonatos/project-v/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thonatos/project-v.git",
    "directory": "packages/plugins/dsh-telegram"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib",
    "src"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./config": "./src/config.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "patch": "node scripts/write-patch.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "pnpm run patch && pnpm run build",
    "prepublishOnly": "pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "node-fetch": "3.3.2",
    "node-telegram-bot-api": "2.1.0",
    "proxy-agent": "6.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  }
}
