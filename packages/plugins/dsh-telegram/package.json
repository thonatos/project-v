{
  "name": "@implementsio/dsh-telegram",
  "version": "1.0.0-dsh.0.2.0-rc.2",
  "description": "Telegram Bot API plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "telegram"
  ],
  "homepage": "https://github.com/thonatos/project-v/tree/main/packages/plugins/dsh-telegram#readme",
  "bugs": {
    "url": "https://github.com/thonatos/project-v/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thonatos/project-v.git",
    "directory": "packages/plugins/dsh-telegram"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib",
    "src"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./config": "./src/config.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "acceptance:plan": "node scripts/local-acceptance-plan.mjs",
    "patch": "node scripts/write-patch.mjs",
    "test": "vp test run",
    "prepack": "pnpm run patch && pnpm run build",
    "prepublishOnly": "pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "https-proxy-agent": "7.0.6",
    "node-fetch": "3.3.2",
    "node-telegram-bot-api": "2.1.0",
    "socks-proxy-agent": "8.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "dsh": "0.2.0-rc.2",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
