{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:host && pnpm run build:core",
    "build:ui": "sh scripts/nsh.sh build macos/ui/App.tsx --release -o build/ui",
    "build:host": "cargo build --manifest-path Cargo.toml --package vela-host",
    "build:core": "mkdir -p build/core && go build -C core -trimpath -o ../build/core/vela-core ./cmd/vela-core",
    "build:app": "sh scripts/build-app.sh",
    "check": "pnpm run check:ui && pnpm run check:host && pnpm run check:core",
    "check:ui": "sh scripts/nsh.sh check macos/ui/App.tsx",
    "check:host": "cargo check --manifest-path Cargo.toml --workspace",
    "check:core": "go test -C core ./...",
    "test": "cargo test --manifest-path Cargo.toml --workspace && go test -C core ./...",
    "test:protocol-docs": "sh scripts/verify-protocol-docs.sh",
    "test:network-isolation": "sh scripts/verify-network-isolation.sh",
    "test:theme": "node macos/ui/tests/theme.test.mjs",
    "test:ui-model": "node shared/ui/projections.test.mjs",
    "test:version": "node shared/ui/version.test.mjs",
    "test:flows": "node shared/ui/flows.test.mjs",
    "test:hostname": "node shared/ui/hostname.test.mjs",
    "test:ui-layout": "node macos/ui/tests/desktop-layout.test.mjs",
    "test:docs": "sh scripts/verify-docs.sh",
    "verify": "sh scripts/verify.sh",
    "verify:release": "sh scripts/verify-release.sh",
    "build:ios": "sh scripts/build-ios.sh",
    "build:ios:core": "sh scripts/build-ios-core.sh build/ios",
    "build:ios:ui": "nsh build ios/ui/App.tsx --release -o build/ui-ios",
    "check:ios": "nsh check ios/ui/App.tsx && cargo check --target aarch64-apple-ios -p vela-ios-native",
    "test:ios": "node ios/ui/tests/structure.test.mjs && node ios/ui/tests/theme.test.mjs && node ios/ui/tests/signing.test.mjs && node shared/ui/ios-projections.test.mjs && sh scripts/verify-ios-deps.sh",
    "install:ios": "sh scripts/install-ios.sh"
  }
}
